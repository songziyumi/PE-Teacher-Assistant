.coach-hero{background:linear-gradient(140deg,rgba(22,50,79,.95),rgba(38,93,140,.86)),#16324f}.coach-hero .page-title,.coach-hero .page-subtitle{color:#fff}.match-card{padding:24rpx}.match-card-head{display:flex;align-items:center;justify-content:space-between;gap:16rpx}.match-card-title{flex:1;font-size:16px;font-weight:700;color:#16324f}.match-tag{padding:6rpx 16rpx;border-radius:999rpx;font-size:12px}.match-tag.is-done{background:#e7f6ee;color:#1f7a4d}.match-tag.is-pending{background:#fff3e0;color:#b26a00}.match-card-meta{margin-top:16rpx;display:grid;gap:8rpx}.match-card-line{font-size:14px;color:#5c6b7a}
