<view class="page-shell">
  <view class="hero-card coach-hero">
    <view class="page-title">赛事管理</view>
    <view class="page-subtitle">赛事报名与首发填报</view>
  </view>

  <view class="panel-card event-entry" bindtap="goSignup">
    <view class="entry-icon">📝</view>
    <view class="entry-content">
      <view class="section-title">赛事报名</view>
      <view class="section-caption">选择运动会和项目，填报运动员及官员名单</view>
    </view>
    <view class="entry-arrow">›</view>
  </view>

  <view class="panel-card event-entry" bindtap="goLineup">
    <view class="entry-icon">🏟️</view>
    <view class="entry-content">
      <view class="section-title">首发填报</view>
      <view class="section-caption">选择本队比赛并提交首发运动员名单</view>
    </view>
    <view class="entry-arrow">›</view>
  </view>
</view>
