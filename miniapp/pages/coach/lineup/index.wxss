.coach-hero {
  background:
    linear-gradient(140deg, rgba(22, 50, 79, 0.95), rgba(38, 93, 140, 0.86)),
    #16324f;
}

.coach-hero .page-title,
.coach-hero .page-subtitle {
  color: #ffffff;
}

.message-box {
  margin-bottom: 20rpx;
  padding: 20rpx 22rpx;
  border-radius: 18rpx;
  font-size: 14px;
  line-height: 1.6;
}

.message-box.is-error {
  background: #fff1f2;
  color: #be123c;
}

.message-box.is-success {
  background: #e7f6ee;
  color: #1f7a4d;
}

.roster-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 8rpx;
  border-bottom: 1rpx solid rgba(22, 50, 79, 0.06);
}

.roster-row.is-checked {
  background: rgba(38, 93, 140, 0.06);
  border-radius: 16rpx;
}

.roster-check {
  width: 40rpx;
  height: 40rpx;
  border-radius: 10rpx;
  border: 2rpx solid rgba(22, 50, 79, 0.2);
  box-sizing: border-box;
}

.roster-check.is-on {
  background: #265d8c;
  border-color: #265d8c;
}

.roster-no {
  width: 64rpx;
  color: #7b8794;
  font-size: 14px;
  text-align: center;
}

.roster-name {
  flex: 1;
  font-size: 16px;
  color: #16324f;
}

.roster-captain {
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: #eaf3fb;
  color: #265d8c;
  font-size: 12px;
}

.submit-button {
  margin-top: 28rpx;
}
