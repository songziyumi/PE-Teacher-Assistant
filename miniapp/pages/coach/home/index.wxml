<view class="page-shell">
  <view class="hero-card coach-hero">
    <view class="hero-top">
      <view>
        <view wx:if="{{user}}" class="page-title">{{user.teamName || user.username}}</view>
        <view wx:else class="page-title">教练员工作台</view>
        <view class="page-subtitle">上报本队球类比赛首发名单</view>
      </view>
      <button class="secondary-button small-button" bindtap="handleLogout">退出</button>
    </view>
  </view>

  <view class="section-heading-row">
    <view class="section-title">常用功能</view>
  </view>

  <view class="feature-grid">
    <view class="feature-card" bindtap="goAthletes">
      <view class="feature-icon">🏃</view>
      <view class="feature-name">运动员管理</view>
      <view class="feature-desc">维护本队运动员</view>
    </view>
    <view class="feature-card" bindtap="goOfficials">
      <view class="feature-icon">👥</view>
      <view class="feature-name">官员管理</view>
      <view class="feature-desc">维护本队领队和教练员</view>
    </view>
    <view class="feature-card" bindtap="goSignupMeets">
      <view class="feature-icon">📝</view>
      <view class="feature-name">赛事报名</view>
      <view class="feature-desc">填报本队参赛名单</view>
    </view>
    <view class="feature-card" bindtap="goTeamProfile"><view class="feature-icon">🏫</view><view class="feature-name">代表队信息</view><view class="feature-desc">查看和编辑本队资料</view></view>
    <view class="feature-card" bindtap="goMe"><view class="feature-icon">👤</view><view class="feature-name">我的</view><view class="feature-desc">账号与密码设置</view></view>
  </view>

  <view wx:if="{{loading}}" class="panel-card">
    <view class="empty-text">正在加载...</view>
  </view>

  <view wx:elif="{{errorMessage}}" class="panel-card">
    <view class="section-title">加载失败</view>
    <view class="page-subtitle">{{errorMessage}}</view>
    <button class="primary-button" bindtap="loadData">重新加载</button>
  </view>

  <block wx:else>
    <view class="section-heading-row">
      <view class="section-title">本队比赛</view>
      <view class="section-caption">共 {{matches.length}} 场</view>
    </view>

    <view wx:if="{{!matches.length}}" class="panel-card">
      <view class="empty-text">当前代表队暂无球类比赛。</view>
    </view>

    <view
      wx:for="{{matches}}"
      wx:key="matchId"
      class="panel-card match-card"
      data-match-id="{{item.matchId}}"
      bindtap="goLineup"
    >
      <view class="match-card-head">
        <view class="match-card-title">{{item.meetName}} · {{item.eventName}}</view>
        <view class="match-tag {{item.reported ? 'is-done' : 'is-pending'}}">{{item.reported ? '已上报' : '待上报'}}</view>
      </view>
      <view class="match-card-meta">
        <view class="match-card-line">对手：{{item.opponent}}</view>
        <view class="match-card-line">{{item.sportLabel}}（{{item.starterCount}} 人首发）</view>
        <view class="match-card-line">{{item.startAtText}} · {{item.venueName || '待定'}}</view>
      </view>
    </view>
  </block>
</view>
