.coach-hero {
  background:
    linear-gradient(140deg, rgba(22, 50, 79, 0.95), rgba(38, 93, 140, 0.86)),
    #16324f;
}

.coach-hero .page-title,
.coach-hero .page-subtitle {
  color: #ffffff;
}

.hero-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.small-button {
  font-size: 14px;
  padding: 4rpx 24rpx;
  margin: 0;
  line-height: 2.2;
}

.section-heading-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 8rpx 8rpx 16rpx;
}

.match-card {
  padding: 24rpx;
}

.match-card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.match-card-title {
  flex: 1;
  font-size: 16px;
  font-weight: 700;
  color: #16324f;
}

.match-tag {
  flex-shrink: 0;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-size: 12px;
  font-weight: 600;
}

.match-tag.is-done {
  background: #e7f6ee;
  color: #1f7a4d;
}

.match-tag.is-pending {
  background: #fff3e0;
  color: #b26a00;
}

.match-card-meta {
  margin-top: 16rpx;
  display: grid;
  gap: 8rpx;
}

.match-card-line {
  font-size: 14px;
  color: #5c6b7a;
}

.feature-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.feature-card {
  background: #ffffff;
  border: 1rpx solid rgba(22, 50, 79, 0.08);
  border-radius: 24rpx;
  padding: 28rpx 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(22, 50, 79, 0.05);
}

.feature-icon {
  font-size: 40rpx;
  line-height: 1;
}

.feature-name {
  margin-top: 16rpx;
  font-size: 16px;
  font-weight: 700;
  color: #16324f;
}

.feature-desc {
  margin-top: 6rpx;
  font-size: 13px;
  color: #7b8794;
}
