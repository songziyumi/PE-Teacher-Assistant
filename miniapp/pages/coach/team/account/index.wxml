<view class="page-shell"><view class="hero-card coach-hero"><view class="page-title">账号设置</view><view class="page-subtitle">查看账号并修改登录密码</view></view><view wx:if="{{loading}}" class="panel-card"><view class="empty-text">正在加载...</view></view><view wx:else><view class="panel-card"><view class="info-row"><view>账号</view><view class="muted-text">{{account.username}}</view></view><view class="info-row"><view>状态</view><view class="muted-text">{{account.enabled ? '正常' : '已停用'}}</view></view></view><view class="panel-card"><view class="section-title">修改密码</view><input class="password-input" password placeholder="当前密码" data-field="currentPassword" bindinput="onInput" /><input class="password-input" password placeholder="新密码（至少6位）" data-field="newPassword" bindinput="onInput" /><input class="password-input" password placeholder="确认新密码" data-field="confirmPassword" bindinput="onInput" /><button class="primary-button submit-button" loading="{{saving}}" disabled="{{saving}}" bindtap="save">保存密码</button></view></view></view>
