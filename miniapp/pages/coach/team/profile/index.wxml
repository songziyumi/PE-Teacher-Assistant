<view class="page-shell"><view class="hero-card coach-hero"><view class="page-title">代表队信息</view><view class="page-subtitle">维护本队联系资料</view></view><view wx:if="{{loading}}" class="panel-card"><view class="empty-text">正在加载...</view></view><view wx:elif="{{errorMessage}}" class="panel-card"><view class="section-title">加载失败</view><view class="page-subtitle">{{errorMessage}}</view><button class="primary-button" bindtap="loadData">重新加载</button></view><view wx:else class="panel-card"><view class="form-row"><view class="form-label">队伍名称</view><input class="form-input" value="{{form.teamName}}" disabled /></view><view class="form-row"><view class="form-label">队伍简称</view><input class="form-input" value="{{form.teamShortName}}" data-field="teamShortName" bindinput="onInput" /></view><view class="form-row"><view class="form-label">联系人</view><input class="form-input" value="{{form.contactName}}" data-field="contactName" bindinput="onInput" /></view><view class="form-row"><view class="form-label">联系电话</view><input class="form-input" type="number" value="{{form.contactPhone}}" data-field="contactPhone" bindinput="onInput" /></view><view class="form-row remark-row"><view class="form-label">备注</view><textarea class="form-textarea" value="{{form.remark}}" data-field="remark" bindinput="onInput" /></view><button class="primary-button submit-button" loading="{{saving}}" disabled="{{saving}}" bindtap="save">保存</button></view></view>
