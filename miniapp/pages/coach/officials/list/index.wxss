.coach-hero { background: linear-gradient(140deg, rgba(22, 50, 79, 0.95), rgba(38, 93, 140, 0.86)), #16324f; }
.coach-hero .page-title, .coach-hero .page-subtitle { color: #ffffff; }
.hero-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 16rpx; }
.small-button { font-size: 14px; padding: 4rpx 24rpx; margin: 0; line-height: 2.2; }
.toolbar { display: flex; align-items: center; gap: 16rpx; margin-bottom: 20rpx; }
.search-box { flex: 1; background: #ffffff; border: 1rpx solid rgba(22, 50, 79, 0.08); border-radius: 20rpx; padding: 0 24rpx; }
.search-input { height: 76rpx; font-size: 15px; color: #1f2937; }
.placeholder { color: #9aa5b1; }
.official-card { padding: 24rpx; }
.official-row { display: flex; align-items: center; gap: 20rpx; }
.official-photo { flex-shrink: 0; width: 112rpx; height: 148rpx; overflow: hidden; border-radius: 14rpx; background: #eef2f6; border: 1rpx solid rgba(22, 50, 79, 0.1); }
.official-photo-image { display: block; width: 100%; height: 100%; }
.official-photo-placeholder { display: flex; align-items: center; justify-content: center; width: 100%; height: 100%; padding: 12rpx; box-sizing: border-box; color: #8a98a8; font-size: 12px; text-align: center; }
.official-main { flex: 1; min-width: 0; }
.official-name-row { display: flex; align-items: baseline; gap: 12rpx; }
.official-name { font-size: 17px; font-weight: 700; color: #16324f; }
.official-gender { font-size: 13px; color: #7b8794; }
.official-tags { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 12rpx; }
.tag { padding: 4rpx 14rpx; border-radius: 999rpx; font-size: 12px; background: #eaf3fb; color: #265d8c; }
.tag.status-on { background: #e7f6ee; color: #1f7a4d; }
.tag.status-off { background: #f1f3f5; color: #7b8794; }
.official-meta { margin-top: 12rpx; display: grid; gap: 6rpx; font-size: 13px; color: #5c6b7a; }
