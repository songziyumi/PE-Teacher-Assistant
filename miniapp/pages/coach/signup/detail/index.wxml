<view class="page-shell">
  <view wx:if="{{loading}}" class="panel-card"><view class="empty-text">正在加载...</view></view>
  <view wx:elif="{{errorMessage}}" class="panel-card"><view class="section-title">加载失败</view><view class="page-subtitle">{{errorMessage}}</view><button class="primary-button" bindtap="loadData">重新加载</button></view>
  <block wx:elif="{{view}}">
    <view class="hero-card coach-hero"><view class="page-title">{{view.meetName}}</view><view class="page-subtitle">{{view.eventName}} · {{view.statusText}} · 报名编号 {{view.id}}</view></view>
    <view class="panel-card"><view class="section-title">运动员名单（{{athletes.length}}）</view><view class="section-caption">{{filterText}}</view><view wx:if="{{!availableAthletes.length}}" class="empty-text">暂无可填报运动员。</view><view wx:for="{{availableAthletes}}" wx:key="id" class="roster-item" data-id="{{item.id}}" bindtap="toggleAthlete"><view class="check {{item.checked?'is-on':''}}"></view><view class="roster-main"><view>{{item.name}} <text>{{item.gender}}</text></view><view class="muted-text">{{item.studentNo || item.idNo || ''}}</view></view><button wx:if="{{item.checked}}" class="captain-button {{item.captain ? 'is-captain' : ''}}" data-id="{{item.id}}" catchtap="setCaptain">{{item.captain ? '队长' : '设队长'}}</button><input wx:if="{{item.checked}}" class="jersey" type="number" value="{{item.jerseyNo}}" data-id="{{item.id}}" catchtap="stopTap" bindinput="onJerseyInput" placeholder="号码" /></view></view>
    <view class="panel-card"><view class="section-title">官员名单（{{officials.length}}）</view><view wx:if="{{!availableOfficials.length}}" class="empty-text">暂无可填报官员。</view><view wx:for="{{availableOfficials}}" wx:key="id" class="roster-item" data-id="{{item.id}}" bindtap="toggleOfficial"><view class="check {{item.checked?'is-on':''}}"></view><view class="roster-main"><view>{{item.name}}</view><view class="muted-text">{{item.personType}} · {{item.phone}}</view></view></view></view>
    <view wx:if="{{qualification}}" class="panel-card"><view class="section-title">资格审核（只读）</view><view class="qualification-grid"><view>总人数：{{qualification.totalCount}}</view><view>待审核：{{qualification.pendingCount}}</view><view>已通过：{{qualification.approvedCount}}</view><view>不通过：{{qualification.rejectedCount}}</view></view><view class="muted-text">{{qualification.lockMessage || (qualification.lockEligible ? '当前名单满足锁定条件' : '')}}</view></view>
    <view class="action-row"><button wx:if="{{view.status === 'DRAFT' || view.status === 'REJECTED'}}" class="primary-button" bindtap="saveRoster">保存名单</button><button wx:if="{{view.status === 'DRAFT' || view.status === 'REJECTED'}}" class="secondary-button" bindtap="submit">提交报名</button><button wx:if="{{view.status === 'SUBMITTED' || view.status === 'APPROVED'}}" class="secondary-button" bindtap="withdraw">撤回报名</button></view>
  </block>
</view>
