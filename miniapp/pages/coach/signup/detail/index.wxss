.coach-hero{background:linear-gradient(140deg,rgba(22,50,79,.95),rgba(38,93,140,.86)),#16324f}.coach-hero .page-title,.coach-hero .page-subtitle{color:#fff}.roster-item{display:flex;align-items:center;gap:18rpx;padding:18rpx 0;border-bottom:1rpx solid rgba(22,50,79,.07)}.roster-item:last-child{border-bottom:0}.check{width:38rpx;height:38rpx;border:2rpx solid rgba(22,50,79,.2);border-radius:10rpx;box-sizing:border-box}.check.is-on{background:#265d8c;border-color:#265d8c}.roster-main{flex:1;min-width:0;color:#16324f;font-size:15px}.roster-main text{font-size:12px;color:#7b8794}.muted-text{font-size:12px;color:#7b8794;margin-top:6rpx}.jersey{width:110rpx;height:58rpx;border:1rpx solid rgba(22,50,79,.14);border-radius:10rpx;text-align:center;font-size:13px}.action-row{display:flex;gap:16rpx;margin-top:20rpx}.action-row button{flex:1}.secondary-button{padding:6rpx 0}
