.coach-hero{background:linear-gradient(140deg,rgba(22,50,79,.95),rgba(38,93,140,.86)),#16324f}.coach-hero .page-title,.coach-hero .page-subtitle{color:#fff}.info-row{display:flex;justify-content:space-between;gap:20rpx;padding:18rpx 0;border-bottom:1rpx solid rgba(22,50,79,.07);font-size:14px;color:#16324f}.info-row view:last-child{text-align:right;color:#5c6b7a}.description{margin-top:20rpx;color:#5c6b7a;font-size:14px;line-height:1.7}.event-item{display:flex;justify-content:space-between;padding:18rpx 0;border-bottom:1rpx solid rgba(22,50,79,.07);font-size:14px;color:#16324f}.event-item text{color:#7b8794;font-size:12px}
