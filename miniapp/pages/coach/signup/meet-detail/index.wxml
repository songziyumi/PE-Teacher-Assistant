<view class="page-shell"><view wx:if="{{loading}}" class="panel-card"><view class="empty-text">正在加载...</view></view><view wx:elif="{{errorMessage}}" class="panel-card"><view class="section-title">加载失败</view><view>{{errorMessage}}</view><button class="primary-button" bindtap="loadData">重新加载</button></view><block wx:else><view class="hero-card coach-hero"><view class="page-title">{{meet.meetName}}</view><view class="page-subtitle">{{meet.startDate}} 至 {{meet.endDate}}</view></view><view class="panel-card"><view class="info-row"><view>状态</view><view>{{meet.status}}</view></view><view class="info-row"><view>举办地点</view><view>{{meet.location || '-'}}</view></view><view class="info-row"><view>主办单位</view><view>{{meet.organizerName || '-'}}</view></view><view class="info-row"><view>联系人</view><view>{{meet.contactName || '-'}} {{meet.contactPhone || ''}}</view></view><view class="info-row"><view>报名时间</view><view>{{meet.signupStartAt || '-'}} 至 {{meet.signupEndAt || '-'}}</view></view><view class="description">{{meet.description || '暂无赛事说明'}}</view></view><view class="panel-card"><view class="section-title">赛事项目（{{events.length}}）</view><view wx:for="{{events}}" wx:key="id" class="event-item"><view>{{item.eventName}}</view><text>{{item.genderScope}} · {{item.teamType}}</text></view></view></block></view>
